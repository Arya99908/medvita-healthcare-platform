# Supabase project URL and anon/publishable key. Never add service-role keys here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional Vercel AI Gateway integration. Never use NEXT_PUBLIC_ for these values.
# The demo uses fictional data. Account summaries require a signed-in patient and
# per-request consent; only RLS-visible general structured records are sent.
# Sensitive adolescent entries and uploaded document contents are excluded.
AI_GATEWAY_API_KEY=
MEDVITA_AI_MODEL=
