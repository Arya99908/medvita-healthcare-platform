# Supabase project URL and anon/publishable key. Never add service-role keys here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional Vercel AI Gateway integration. Never use NEXT_PUBLIC_ for these values.
# Only fictional presentation data is sent; live summaries require a signed-in user.
AI_GATEWAY_API_KEY=
MEDVITA_AI_MODEL=
